#pragma once
// 由 cmake/MiniBIMVersion.cmake 在每次构建时从 apps/Common/src/MiniBIMVersion.h.in 生成，不要手改。
// 前三段来自根 CMakeLists.txt 的 MINIBIM_VERSION；文件版本第四段为构建号（git 提交数，取不到时为 0），
// 产品版本第四段：MINIBIM_VERSION 为四段时取其第四段，否则同构建号。
#define MINIBIM_VERSION_MAJOR @MINIBIM_VERSION_MAJOR@
#define MINIBIM_VERSION_MINOR @MINIBIM_VERSION_MINOR@
#define MINIBIM_VERSION_PATCH @MINIBIM_VERSION_PATCH@
#define MINIBIM_VERSION_BUILD @MINIBIM_VERSION_BUILD@
#define MINIBIM_VERSION_TWEAK @MINIBIM_VERSION_TWEAK@
#define MINIBIM_VERSION_STRING "@MINIBIM_VERSION@"                                    // 发布版本（与发布标签 v… 相同）
#define MINIBIM_FILE_VERSION_STRING "@MINIBIM_VERSION_BASE@.@MINIBIM_VERSION_BUILD@"   // 文件版本（第四段为构建号）

// 资源文件（MiniBIM.rc）用的字符串，末尾的 \0 是 VERSIONINFO 字符串要求的结束符
#define MINIBIM_FILE_VERSION_STR "@MINIBIM_VERSION_BASE@.@MINIBIM_VERSION_BUILD@\0"
#define MINIBIM_PRODUCT_VERSION_STR "@MINIBIM_VERSION@\0"
