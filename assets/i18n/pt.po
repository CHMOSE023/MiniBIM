#: apps/Common/src/GUI/Tools.cpp
msgid "Click a sketch line to select it, Ctrl adds; drag a selected line's end to move it. Delete removes, Ctrl+Z steps back."
msgstr "Clique em uma linha de esboço para selecioná-la, Ctrl adiciona; arraste a extremidade de uma linha selecionada para movê-la. Delete exclui, Ctrl+Z desfaz."

#: apps/Common/src/GUI/Tools.cpp
msgid "Click to select, Ctrl adds or takes away, Esc clears; drag or middle-drag to pan, scroll to zoom"
msgstr "Clique para selecionar, Ctrl adiciona ou remove, Esc limpa; arraste ou arraste com o botão do meio para deslocar, role para zoom"

#: apps/Common/src/GUI/Tools.cpp
msgid "Click to enter the wall's start point."
msgstr "Clique para indicar o ponto inicial da parede."

#: apps/Common/src/GUI/Tools.cpp
msgid "Click to build the wall to the next point, or type a length and press Enter. Enter or Esc ends the chain, Shift keeps it square."
msgstr "Clique para construir a parede até o próximo ponto, ou digite um comprimento e pressione Enter. Enter ou Esc termina a cadeia, Shift a mantém ortogonal."

#: apps/Common/src/GUI/Tools.cpp
msgid "Click a wall to place the door."
msgstr "Clique numa parede para inserir a porta."

#: apps/Common/src/GUI/Tools.cpp
msgid "Click a wall to place the window."
msgstr "Clique numa parede para inserir a janela."

#: apps/Common/src/GUI/Tools.cpp
msgid "Click where the component goes; Space turns it a quarter turn."
msgstr "Clique onde vai o componente; Espaço o gira um quarto de volta."

#: apps/Common/src/GUI/Tools.cpp
msgid "Click inside the walls to roof them, on the level above: the overhang runs past their faces."
msgstr "Clique dentro das paredes para cobri-las, no nível acima: o beiral passa das faces."

#: apps/Common/src/GUI/Tools.cpp
msgid "Click inside the walls to floor them: the slab runs under their outline, its top at the level."
msgstr "Clique dentro das paredes para criar o piso: a laje passa sob o contorno delas, com o topo no nível."

#: apps/Common/src/GUI/Tools.cpp
msgid "Click inside a room: a ceiling out to its walls' faces, as high as the Options Bar says."
msgstr "Clique dentro de um ambiente: um forro até as faces das paredes, na altura que a barra de opções indica."

#: apps/Common/src/GUI/Tools.cpp
msgid "Click inside walls to place a room; the outline shows the room you'd get."
msgstr "Clique dentro das paredes para inserir um ambiente; o contorno mostra o ambiente resultante."

#: apps/Common/src/GUI/Tools.cpp
msgid "Type the new level's elevation in the Options Bar, then Create."
msgstr "Digite a elevação do novo nível na Barra de opções e clique em Criar."

#: apps/Common/src/GUI/Tools.cpp
msgid "Click to enter the grid's start point."
msgstr "Clique para indicar o ponto inicial do eixo."

#: apps/Common/src/GUI/Tools.cpp
msgid "Click to enter the grid's end point."
msgstr "Clique para indicar o ponto final do eixo."

#: apps/Common/src/GUI/Tools.cpp
msgid "Click a base point to measure from."
msgstr "Clique num ponto base de referência."

#: apps/Common/src/GUI/Tools.cpp
msgid "Click where the base point goes. Esc cancels."
msgstr "Clique onde vai o ponto base. Esc cancela."

#: apps/Common/src/GUI/Tools.cpp
msgid "Click where the copy's base point goes. Esc cancels."
msgstr "Clique onde vai o ponto base da cópia. Esc cancela."

#: apps/Common/src/GUI/Tools.cpp
msgid "Click the centre of rotation."
msgstr "Clique no centro de rotação."

#: apps/Common/src/GUI/Tools.cpp
msgid "Click the start of the angle, or type an angle in the Options Bar."
msgstr "Clique no início do ângulo, ou digite um ângulo na Barra de opções."

#: apps/Common/src/GUI/Tools.cpp
msgid "Click the end of the angle. Esc cancels."
msgstr "Clique no fim do ângulo. Esc cancela."

#: apps/Common/src/GUI/Tools.cpp
msgid "Pick a wall or grid to mirror across."
msgstr "Selecione uma parede ou um eixo como espelho."

#: apps/Common/src/GUI/Tools.cpp
msgid "Click the start of the mirror axis."
msgstr "Clique no início do eixo de espelhamento."

#: apps/Common/src/GUI/Tools.cpp
msgid "Click the end of the mirror axis."
msgstr "Clique no fim do eixo de espelhamento."

#: apps/Common/src/GUI/Tools.cpp
msgid "Pick the element's highlighted edge to move and turn onto the reference."
msgstr "Selecione a aresta destacada do elemento a mover e girar até a referência."

#: apps/Common/src/GUI/Tools.cpp
msgid "Pick a reference edge or centre line; the line under the cursor is highlighted."
msgstr "Selecione uma aresta ou linha de centro de referência; a linha sob o cursor fica destacada."

#: apps/Common/src/GUI/Tools.cpp
msgid "Pick the second wall, on the part to keep."
msgstr "Selecione a segunda parede, na parte a manter."

#: apps/Common/src/GUI/Tools.cpp
msgid "Pick the first wall, on the part to keep."
msgstr "Selecione a primeira parede, na parte a manter."

#: apps/Common/src/GUI/Tools.cpp
msgid "Click a wall where to split it."
msgstr "Clique em uma parede onde dividi-la."

#: apps/Common/src/GUI/Tools.cpp
msgid "Point to a wall: the offset goes to the cursor's side. Click to place it."
msgstr "Aponte para uma parede: o deslocamento vai para o lado do cursor. Clique para posicioná-lo."

#: apps/Common/src/GUI/Tools.cpp
msgid "Click to start a line."
msgstr "Clique para iniciar uma linha."

#: apps/Common/src/GUI/Tools.cpp
msgid "Click the line's end, or type a length and press Enter; back at the start closes the loop. Enter or Esc ends the chain."
msgstr "Clique no final da linha, ou digite um comprimento e pressione Enter; voltar ao início fecha o contorno. Enter ou Esc termina a cadeia."

#: apps/Common/src/GUI/Tools.cpp
msgid "Click the rectangle's first corner."
msgstr "Clique no primeiro canto do retângulo."

#: apps/Common/src/GUI/Tools.cpp
msgid "Click the opposite corner."
msgstr "Clique no canto oposto."

#: apps/Common/src/GUI/Tools.cpp
msgid "Pick walls: each adds a line along the wall's location line."
msgstr "Selecione paredes: cada uma adiciona uma linha ao longo da sua linha de localização."

