msgid "The loop is open: {0} line ends don't meet another line."
msgstr "O contorno está aberto: {0} pontas de linha não encontram outra linha."

#: apps/Common/src/GUI/SketchMode.cpp
msgid "A loop encloses no area."
msgstr "Um contorno não encerra área."

#: apps/Common/src/GUI/SketchMode.cpp
