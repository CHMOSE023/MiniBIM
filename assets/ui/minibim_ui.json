// MiniBIM 界面描述（MiniBIMWin，界面由 MiniGUI 绘制；格式见 src/UI/Widgets/UiLayout.h，同 MiniCAD 的 minicad_ui.json）
// 程序运行时修改并保存本文件，界面立即更新；写错时保留当前界面，状态栏显示错误位置。
// 多语言：title / label / tooltip / text 一律写英文原文，显示时按当前语言翻译（词典在 assets/i18n）；
//   改了这里的文字后运行 python tools/extract_messages.py 更新词典，再补上译文
// - 菜单文字不写助记符 &：菜单上不显示下划线，也不显示 "(F)" 这样的字母（键盘用 F10 激活菜单栏、方向键选择）
// - menus / toolbars 的项是命令 ID，"-" 为分隔线；{ "title": …, "dynamic": "languages" } 是程序生成的语言列表
// - ribbons：功能区（布局里 { "type": "ribbon", "id": … } 引用）：选项卡 → 组 → 命令
// - 宿主提供的面板：viewport（视图：三维或平面）、options（选项栏：当前工具的选项）、properties（特性）、browser（项目浏览器）、
//   statusbar（状态栏）
// - dock：停靠区，root 为布局树（split: row / column，tabs: 面板列表，size: 尺寸）；拖动面板标签可停靠到别处、合并为标签或浮出
// - 图标（commands 的 "icon"、titlebar 的 "icon"）都在 assets/icons，由 tools/make_icons.py 生成：要新图标先在脚本里加，
//   再在这里引用（python tools/make_icons.py --check 核对引用）。菜单项不显示图标
{
  "commands": {
    "file.new":     { "icon": "New.png", "shortcut": "Ctrl+N" },
    "file.open":    { "icon": "Open.png", "shortcut": "Ctrl+O" },
    "file.save":    { "icon": "Save.png", "shortcut": "Ctrl+S" },
    "file.saveAs":  { "icon": "SaveAs.png", "shortcut": "Ctrl+Shift+S" },
    "file.exportIfc": { "icon": "ExportIfc.png" },
    "file.sample":  { "icon": "SampleHouse.png" },
    "file.start":   { "icon": "StartPage.png", "shortcut": "Ctrl+D" },
    "file.exit":    { "icon": "Exit.png" },
    "edit.undo":    { "icon": "Undo.png", "shortcut": "Ctrl+Z" },
    "edit.redo":    { "icon": "Redo.png", "shortcut": "Ctrl+Y" },
    "edit.delete":  { "icon": "Delete.png", "shortcut": "Delete" },
    "edit.escape":  { "shortcut": "Esc" },
    "modify.select": { "icon": "Select.png" },
    "modify.flip":  { "icon": "FlipWall.png" },
    "modify.typeProperties": { "icon": "TypeProperties.png" },
    "manage.materials":      { "icon": "Materials.png" },
    "modify.align":      { "icon": "Align.png" },
    "modify.offset":     { "icon": "Offset.png" },
    "modify.mirrorPick": { "icon": "MirrorPick.png" },
    "modify.mirrorDraw": { "icon": "MirrorDraw.png" },
    "modify.split":      { "icon": "Split.png" },
    "modify.move":       { "icon": "Move.png" },
    "modify.copy":       { "icon": "Copy.png" },
    "modify.rotate":     { "icon": "Rotate.png" },
    "modify.trim":       { "icon": "Trim.png" },
    "modify.editBoundary": { "icon": "EditBoundary.png" },
    "sketch.finish":     { "icon": "FinishSketch.png" },
    "sketch.cancel":     { "icon": "CancelSketch.png" },
    "sketch.line":       { "icon": "SketchLine.png" },
    "sketch.rectangle":  { "icon": "SketchRectangle.png" },
    "sketch.pickWalls":  { "icon": "PickWalls.png" },
    "arch.wall":      { "icon": "Wall.png" },
    "arch.door":      { "icon": "Door.png" },
    "arch.window":    { "icon": "Window.png" },
    "arch.component": { "icon": "Component.png" },
    "arch.roof":      { "icon": "Roof.png" },
    "arch.floor":     { "icon": "Floor.png" },
    "arch.ceiling":   { "icon": "Ceiling.png" },
    "arch.room":      { "icon": "Room.png" },
    "arch.level":     { "icon": "Level.png" },
    "arch.grid":      { "icon": "Grid.png" },
    "view.3d":        { "icon": "View3D.png" },
    "view.plan":      { "icon": "FloorPlan.png" },
    "view.levelUp":   { "icon": "LevelUp.png", "shortcut": "PageUp" },
    "view.levelDown": { "icon": "LevelDown.png", "shortcut": "PageDown" },
    "view.home":    { "icon": "HomeView.png" },
    "view.zoomFit": { "icon": "ZoomFit.png" },
    "view.properties": { "icon": "Properties.png" },
    "view.browser":    { "icon": "ProjectBrowser.png" },
    "help.about":   { "icon": "About.png" }
  },
  "menus": [
    { "title": "File", "items": [ "file.new", "file.open", { "title": "Open Recent", "dynamic": "recent" }, "file.save", "file.saveAs",
                                  "file.exportIfc", "-", "file.start", "file.sample", "-",
                                  { "title": "Language", "dynamic": "languages" }, "-", "file.exit" ] },
    { "title": "Edit", "items": [ "edit.undo", "edit.redo", "-", "edit.delete", "modify.flip" ] },
    { "title": "View", "items": [ "view.3d", "view.plan", "view.levelUp", "view.levelDown", "-", "view.home", "view.zoomFit", "-",
                                  "view.properties", "view.browser" ] },
    { "title": "Help", "items": [ "help.about" ] }
  ],
  "toolbars": {
    "quick": [ "file.start", "file.open", "file.save", "edit.undo", "edit.redo" ]
  },
  "ribbons": {
    "main": {
      "search": false,
      "tabs": [
        {
          "title": "Architecture",
          "panels": [
            { "title": "Select", "items": [ "modify.select" ] },
            { "title": "Build", "items": [ "arch.wall", "arch.door", "arch.window", "arch.component", "arch.roof", "arch.floor", "arch.ceiling" ] },
            { "title": "Room & Area", "items": [ "arch.room" ] },
            { "title": "Datum", "items": [ "arch.level", "arch.grid" ] }
          ]
        },
        {
          "title": "Modify",
          "panels": [
            { "title": "Select", "items": [ "modify.select" ] },
            { "title": "Properties", "items": [ "view.properties", "modify.typeProperties" ] },
            { "title": "Modify", "items": [ "modify.align", "modify.offset", "modify.mirrorPick", "modify.mirrorDraw", "modify.split",
                                            "modify.move", "modify.copy", "modify.rotate", "modify.trim", "edit.delete" ] },
            { "title": "Wall", "items": [ "modify.flip" ] },
            // 草图模式（编辑边界，楼板、天花板、屋顶的边界线）：完成、取消与画草图线的工具，不在草图模式时灰掉
            { "title": "Mode", "items": [ "modify.editBoundary", "sketch.finish", "sketch.cancel" ] },
            { "title": "Draw", "items": [ "sketch.line", "sketch.rectangle", "sketch.pickWalls" ] }
          ]
        },
        {
          "title": "View",
          "panels": [
            { "title": "Create", "items": [ "view.3d", "view.plan", "view.levelUp", "view.levelDown" ] },
            { "title": "Navigate", "items": [ "view.home", "view.zoomFit" ] },
            { "title": "Palettes", "items": [ "view.properties", "view.browser" ] }
          ]
        },
        {
          "title": "Manage",
          "panels": [
            { "title": "Settings", "items": [ "manage.materials" ] }
          ]
        }
      ]
    }
  },
  "layout": {
    "type": "column",
    "children": [
      {
        "type": "titlebar",
        "icon": "app.png",
        "shrink": 0,
        "children": [
          { "type": "menubar", "compact": true, "shrink": 0 },
          { "type": "toolbar", "id": "quick", "iconSize": 18, "padding": [ 0, 3, 4, 3 ] }
        ]
      },
      { "type": "ribbon", "id": "main", "shrink": 0 },
      // 选项栏：当前工具的选项（墙的高度与定位线、屋顶的坡度……），没有工具时只有一行提示
      { "type": "panel", "name": "options", "shrink": 0 },
      // 特性在左上、项目浏览器在左下（同 Revit），右边是视图
      {
        "type": "dock",
        "id": "main",
        "grow": 1,
        "root": {
          "split": "row",
          "children": [
            {
              "split": "column",
              "size": 300,
              "children": [
                { "tabs": [ "properties" ] },
                { "tabs": [ "browser" ], "size": 300 }
              ]
            },
            { "tabs": [ { "panel": "viewport", "header": false, "closable": false } ] }
          ]
        }
      },
      { "type": "panel", "name": "statusbar", "shrink": 0 }
    ]
  }
}
