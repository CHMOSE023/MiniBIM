  "menus": [
    { "title": "File", "items": [ "file.new", "file.open", { "title": "Open Recent", "dynamic": "recent" }, "file.save", "file.saveAs",
                                  "file.exportIfc", "file.revitReport", "-", "file.start", "file.sample", "-",
                                  { "title": "Language", "dynamic": "languages" }, "file.settings", "file.shortcuts", "-", "file.exit" ] },
    { "title": "Edit", "items": [ "edit.undo", "edit.redo", "-", "edit.delete", "modify.flip" ] },
    { "title": "View", "items": [ "view.3d", "view.plan", "view.levelUp", "view.levelDown", "-", "view.home", "view.zoomFit", "-",
                                  "view.properties", "view.browser" ] },
    { "title": "Help", "items": [ "help.about" ] }
  ],
  "toolbars": {
    "quick": [ "file.start", "file.open", "file.save", "edit.undo", "edit.redo" ]
  },
  "ribbons": {
    "main": {
      "search": false,
      "tabs": [
        {
          "title": "Architecture",
          "panels": [
            { "title": "Select", "items": [ "modify.select" ] },
            { "title": "Build", "items": [ "arch.wall", "arch.door", "arch.window", "arch.column", "arch.component", "arch.roof", "arch.floor", "arch.ceiling" ] },
            { "title": "Room & Area", "items": [ "arch.room" ] },
            { "title": "Datum", "items": [ "arch.level", "arch.grid" ] }
          ]
        },
        {
          "title": "Structure",
          "panels": [
            { "title": "Select", "items": [ "modify.select" ] },
            { "title": "Structure", "items": [ "struct.column", "struct.beam", "struct.floor" ] },
            { "title": "Foundation", "items": [ "struct.footing", "struct.wallFooting" ] },
            { "title": "Datum", "items": [ "arch.level", "arch.grid" ] }
          ]
        },
        // 卫浴、电气、防雷、数据（BIMCraft 的四个专业选项卡；防雷与数据 Revit 没有）
        {
          "title": "Plumbing",
          "panels": [
            { "title": "Select", "items": [ "modify.select" ] },
            { "title": "Plumbing & Piping", "items": [ "mep.pipe", "mep.plumbing", "mep.fitting", "mep.accessory" ] }
          ]
        },
        {
          "title": "Electrical",
          "panels": [
            { "title": "Select", "items": [ "modify.select" ] },
            { "title": "Electrical", "items": [ "mep.equipment", "mep.device", "mep.lighting" ] },
            { "title": "Conduit & Wire", "items": [ "mep.conduit", "mep.cableTray", "mep.wire" ] }
          ]
        },
        {
          "title": "Lightning Protection",
          "panels": [
            { "title": "Select", "items": [ "modify.select" ] },
            { "title": "Capture & Descent", "items": [ "mep.airTerminal", "mep.downConductor" ] },
            { "title": "Earthing", "items": [ "mep.earthing", "mep.inspection", "mep.groundConductor" ] }
          ]
        },
        {
          "title": "Data",
          "panels": [
            { "title": "Select", "items": [ "modify.select" ] },
            { "title": "Outlets & Equipment", "items": [ "mep.dataOutlet", "mep.voiceOutlet", "mep.rack", "mep.patchPanel" ] },
            { "title": "Cabling", "items": [ "mep.cableTray", "mep.cabling" ] }
          ]
        },
        // 插入：链接的模型、从文件插入（CAD 与点云随第 5g2、5g3 步加进来）
        {
          "title": "Insert",
          "panels": [
            { "title": "Select", "items": [ "modify.select" ] },
            { "title": "Link", "items": [ "insert.link", "insert.linkCad", "insert.manageLinks" ] },
            { "title": "Import", "items": [ "insert.importCad", "insert.fromFile" ] }
          ]
        },
        // 注释：标高平面里的尺寸、详图线、区域、文字、测量与标记
        {
          "title": "Annotate",
          "panels": [
            { "title": "Select", "items": [ "modify.select" ] },
            { "title": "Dimension", "items": [ "annotate.aligned", "annotate.angular", "annotate.radial", "annotate.spot" ] },
            { "title": "Detail", "items": [ "annotate.detailLine" ] },
            { "title": "Region", "items": [ "annotate.filledRegion", "annotate.maskingRegion" ] },
            { "title": "Text", "items": [ "annotate.text" ] },
            { "title": "Measure", "items": [ "annotate.measure" ] },
            { "title": "Tag", "items": [ "annotate.tag", "annotate.tagAll" ] }
          ]
        },
        // 体量：概念体量；按面建模对选中的体量（没选体量时灰掉）。显示体量随视图的可见性移植
        {
          "title": "Massing",
          "panels": [
            { "title": "Select", "items": [ "modify.select" ] },
            { "title": "Conceptual Mass", "items": [ "massing.mass" ] },
            { "title": "Model by Face", "items": [ "massing.floors", "massing.wallByFace", "massing.floorByFace", "massing.roofByFace",
                                                   "massing.updateByFace" ] }
          ]
        },
        {
          "title": "Modify",
          "panels": [
            { "title": "Select", "items": [ "modify.select" ] },
            { "title": "Properties", "items": [ "view.properties", "modify.typeProperties" ] },
            { "title": "Modify", "items": [ "modify.align", "modify.offset", "modify.mirrorPick", "modify.mirrorDraw", "modify.split",
                                            "modify.move", "modify.copy", "modify.rotate", "modify.trim", "edit.delete" ] },
            { "title": "Wall", "items": [ "modify.flip" ] },
            // 草图模式（编辑边界，楼板、天花板、屋顶的边界线）：完成、取消与画草图线的工具，不在草图模式时灰掉
            { "title": "Mode", "items": [ "modify.editBoundary", "sketch.finish", "sketch.cancel" ] },
            { "title": "Draw", "items": [ "sketch.line", "sketch.rectangle", "sketch.pickWalls" ] }
          ]
        },
        {
          "title": "View",
          "panels": [
            { "title": "Graphics", "items": [ "view.visibility", "view.filters", "view.template", "view.crop" ] },
            { "title": "Create", "items": [ "view.3d", "view.plan", "view.duplicate", "view.detailing", "view.dependent", "view.section", "view.elevation", "view.schedule", "view.levelUp", "view.levelDown" ] },
            { "title": "Sheet Composition", "items": [ "view.sheet", "view.placeView" ] },
            { "title": "Navigate", "items": [ "view.home", "view.zoomFit" ] },
            { "title": "Palettes", "items": [ "view.properties", "view.browser" ] }
          ]
        },
        {
          "title": "Manage",
          "panels": [
            { "title": "Settings", "items": [ "manage.materials", "manage.objectStyles", "manage.lineStyles", "manage.lineWeights", "manage.fillPatterns", "manage.parameters" ] },
            { "title": "Clean Up", "items": [ "manage.purge" ] }
          ]
        }
      ]
    }
  },
  "layout": {
    "type": "column",
    "children": [
      {
        "type": "titlebar",
        "icon": "app.png",
        "shrink": 0,
        "children": [
          { "type": "menubar", "compact": true, "shrink": 0 },
          { "type": "toolbar", "id": "quick", "iconSize": 18, "padding": [ 0, 3, 4, 3 ] }
        ]
      },
      // 标题栏以下整个是视图（canvas：三维或平面），功能区、选项栏、停靠面板、状态栏叠在它上面（照 MiniCAD）。
      // 浮动布局里它们是圆角卡片，四周与之间留 6 像素的缝露出视图；紧凑布局（变体 compact）里方角贴边、没有缝
      {
        "type": "column",
        "grow": 1,
        "children": [
          { "type": "panel", "name": "canvas", "position": "absolute", "left": 0, "top": 0, "right": 0, "bottom": 0 },
          // 叠在视图上的一层：空白处点击穿透到视图
          {
            "type": "column",
            "position": "absolute", "left": 0, "top": 0, "right": 0, "bottom": 0,
            "padding": 6,
            "gap": 6,
            "passThrough": true,
            "variants": { "compact": { "padding": 0, "gap": 0 } },
            "children": [
              { "type": "ribbon", "id": "main", "shrink": 0, "variants": { "compact": { "card": false } } },
              // 选项栏：当前工具的选项（墙的高度与定位线、屋顶的坡度……），没有工具时只有一行提示
              { "type": "panel", "name": "options", "shrink": 0, "card": true, "variants": { "compact": { "card": false } } },
              // 停靠区（"floating"：叠在视图上，空白处点击穿透）：特性在左上、项目浏览器在左下（同 Revit），
              // 右边的 viewport 是视图的位置——透明的"洞"，露出下面的视图（框住模型时放进这里）
              {
                "type": "dock",
                "id": "main",
                "grow": 1,
                "gap": 6,
                "floating": true,
                "variants": { "compact": { "gap": 0 } },
                "root": {
                  "split": "row",
                  "children": [
                    {
                      "split": "column",
                      "size": 300,
                      "children": [
                        { "tabs": [ "properties" ] },
                        { "tabs": [ "browser" ], "size": 300 }
                      ]
                    },
                    { "tabs": [ { "panel": "viewport", "header": false, "closable": false } ] }
                  ]
                }
              },
              { "type": "panel", "name": "statusbar", "shrink": 0, "card": true, "variants": { "compact": { "card": false } } }
            ]
          }
        ]
      }
    ]
  }
}
