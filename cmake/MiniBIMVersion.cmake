# 每次构建时由 apps/Common/CMakeLists.txt 以 cmake -P 调用，生成 MiniBIMVersion.h。
# 参数：VERSION（三段或四段，来自根 CMakeLists.txt 的 MINIBIM_VERSION）、SOURCE_DIR（仓库根）、INPUT、OUTPUT。
# 文件版本第四段为构建号，取 git 提交数（git rev-list --count HEAD）；没有 git 或不是完整克隆时为 0。
# 产品版本：VERSION 为四段（如 0.2.1.1）时第四段用它自己的，三段时同文件版本取构建号。
# configure_file 内容不变时不改写文件，构建号没变就不会重新编译资源。

string(REPLACE "." ";" MINIBIM_VERSION_PARTS "${VERSION}")
list(GET MINIBIM_VERSION_PARTS 0 MINIBIM_VERSION_MAJOR)
list(GET MINIBIM_VERSION_PARTS 1 MINIBIM_VERSION_MINOR)
list(GET MINIBIM_VERSION_PARTS 2 MINIBIM_VERSION_PATCH)
list(LENGTH MINIBIM_VERSION_PARTS MINIBIM_VERSION_PART_COUNT)
set(MINIBIM_VERSION "${VERSION}")
set(MINIBIM_VERSION_BASE "${MINIBIM_VERSION_MAJOR}.${MINIBIM_VERSION_MINOR}.${MINIBIM_VERSION_PATCH}")

set(MINIBIM_VERSION_BUILD 0)
find_package(Git QUIET)
if(GIT_FOUND)
    execute_process(
        COMMAND "${GIT_EXECUTABLE}" rev-list --count HEAD
        WORKING_DIRECTORY "${SOURCE_DIR}"
        OUTPUT_VARIABLE GIT_COMMIT_COUNT
        RESULT_VARIABLE GIT_RESULT
        OUTPUT_STRIP_TRAILING_WHITESPACE
        ERROR_QUIET
    )
    # FILEVERSION 每段是 16 位
    if(GIT_RESULT EQUAL 0 AND GIT_COMMIT_COUNT MATCHES "^[0-9]+$" AND GIT_COMMIT_COUNT LESS 65536)
        set(MINIBIM_VERSION_BUILD ${GIT_COMMIT_COUNT})
    endif()
endif()

if(MINIBIM_VERSION_PART_COUNT GREATER 3)
    list(GET MINIBIM_VERSION_PARTS 3 MINIBIM_VERSION_TWEAK)
else()
    set(MINIBIM_VERSION_TWEAK ${MINIBIM_VERSION_BUILD})
endif()

configure_file("${INPUT}" "${OUTPUT}" @ONLY)
